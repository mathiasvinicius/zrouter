# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/app/data

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# ─────────────────────────────────────────────────────────────
# MEMÓRIA DE IDENTIDADE (Neo4j)
# Neo4j é o ÚNICO backend de memória. O Hindsight foi removido — um valor
# legado "hindsight" é coagido para "neo4j" (um log, nunca um erro).
# ─────────────────────────────────────────────────────────────
IDENTITY_MEMORY_BACKEND=neo4j

# Conexão. Modo A (stack bundled): http://127.0.0.1:7474.
# Modo B (Neo4j que já existe): aponte para o seu host — use Tailscale/VPN
# para acesso remoto e NUNCA exponha o Neo4j na internet.
NEO4J_HTTP_URL=http://127.0.0.1:7474
NEO4J_DATABASE=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
# Alternativa ao par USER/PASSWORD acima, usada pelo Neo4j embutido:
# NEO4J_AUTH=neo4j/change-me-neo4j

# Recall (busca de memória antes da inferência).
NEO4J_RECALL_LIMIT=12              # máximo de memórias devolvidas por recall
NEO4J_RECALL_MAX_CHARS=5600        # teto de caracteres injetados no prompt
NEO4J_RECALL_DEDUP_TTL_MS=300000   # 5 min: repete a mesma busca no mesmo intervalo
NEO4J_RETAIN_DEDUP_TTL_MS=900000   # 15 min: não regrava a mesma mensagem

# Memória do container Neo4j embutido (profile "bundled"). Os defaults servem
# para um host modesto. Em host com ≤4GB de RAM baixe para 512M/256M/512M.
NEO4J_HEAP_MAX=2G
NEO4J_HEAP_INITIAL=512M
NEO4J_PAGECACHE=1G

# ─────────────────────────────────────────────────────────────
# FONTES DE CONHECIMENTO (per-key sources)
# As dependências vêm declaradas no docker-compose.yml atrás do profile
# OPT-IN "bundled": `docker compose up -d` sobe só o gateway. As mesmas
# regras valem para o Open Notebook (Modo B):
# OPEN_NOTEBOOK_URL=http://<host-do-seu-open-notebook>:5055
# ─────────────────────────────────────────────────────────────

# Open Notebook (biblioteca documental: PDFs, URLs, notas)
OPEN_NOTEBOOK_URL=http://127.0.0.1:5055
OPEN_NOTEBOOK_PASSWORD=change-me-open-notebook
# Credenciais internas dos serviços bundled (compose):
SURREAL_USER=open_notebook
SURREAL_PASSWORD=change-me-surreal
OPEN_NOTEBOOK_ENCRYPTION_KEY=change-me-32-chars-minimum-secret

# Notion (read-only) — crie a integração em notion.so/my-integrations
# até o token existir o backend retorna "not-configured". Só leitura.
# NOTION_TOKEN=load-from-a-runtime-secret

# LLM/OCR do Open Notebook: registre providers no dashboard dele
# (aponta para o próprio ZRouter/9Router como endpoint OpenAI-compatible).

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router

# ─────────────────────────────────────────────────────────────
# OAuth — Google CLI clients (Gemini / Antigravity)
# Credenciais NÃO ficam no repositório. Crie as suas em
# console.cloud.google.com (OAuth 2.0 Client ID, tipo "Desktop app")
# ou reutilize as do CLI público do Google, se preferir.
# Sem isso, os providers gemini-cli/antigravity não autenticam.
# ─────────────────────────────────────────────────────────────
# GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxx
# ANTIGRAVITY_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=GOCSPX-xxxxx
